# Copy this file to ".env" and fill in your real keys.
# .env is git-ignored so your keys never get committed.

# ElevenLabs -- https://elevenlabs.io/  (Profile -> API Key)
ELEVENLABS_API_KEY=your-elevenlabs-key-here

# 60db -- https://60db.ai/  (Dashboard -> API Keys, looks like sk_live_...)
SIXTYDB_API_KEY=your-60db-key-here
